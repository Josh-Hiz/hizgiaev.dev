---
import InfoLayout from '../layouts/InfoLayout.astro';

const pageTitle = 'Experience & Skills';

const languages: string[] = [
  'C++17/20/23', 'Python', 'C#', 'Java', 'JavaScript', 'SQL'
];

const systemsperf: string[] = [
  'Linux', 'CUDA', 'OpenMP', 'Boost', 'WebSockets', 'pybind11', 'NVIDIA CUPTI', 'GDB', 'Valgrind'
];

const tools: string[] = [
  'CMake', 'Ninja', 'GCC/G++', 'Clang/LLVM', 'Git', 'Docker', 'OpenSSH', 'Bash', 'NUnit'
]

const libraries: string[] = [
  'NumPy', 'Pandas', 'SciPy', 'scikit-learn', 'PyTorch', 'ClickHouse', 'PostgreSQL', 'PySpark', 'TensorFlow'
]

const backend: string[] = [
  '.NET', 'ASP.NET', 'Microsoft Azure', 'Microsoft SQL Server', 'MongoDB', 'Apache Spark'
];



interface ExperienceEntry {
  title: string;
  org:   string;
  date:  string;
  /** ISO date range for <time> elements — [start, end|present] */
  iso:   [string, string];
}

const experience: ExperienceEntry[] = [
  {
    title: 'C++ Software Engineer',
    org:   'Trexquant • New York City, NY',
    date:  'Aug 2026 - Present',
    iso:   ['2026-08', ''],
  },
  {
    title: 'Quantitative Analyst | Head of Multi-Factor Model Development',
    org:   'Stevens Student Managed Investment Fund • Hoboken, NJ',
    date:  'Sep 2025 - May 2026',
    iso:   ['2025-09', '2026-05'],
  },
  {
    title: 'Teaching Assistant',
    org:   'Stevens Institute of Technology • Hoboken, NJ',
    date:  'Jan 2023 - Dec 2025',
    iso:   ['2023-01', '2025-12'],
  },
  {
    title: 'Software Engineer Intern',
    org:   'Quantifi • New York City, NY',
    date:  'May 2025 - Aug 2025',
    iso:   ['2025-05', '2025-08'],
  },
  {
    title: 'Software Engineer Intern',
    org:   'PanAgora Asset Management • Boston, MA',
    date:  'May 2024 - Aug 2024',
    iso:   ['2024-05', '2024-08'],
  },
  {
    title: 'Summer AI Research Assistant',
    org:   'Stevens Institute of Artificial Intelligence • Hoboken, NJ',
    date:  'Jun 2023 - Aug 2023',
    iso:   ['2023-06', '2023-08'],
  },
  {
    title: 'Undergraduate Research Assistant',
    org:   'Stevens Institute of Technology • Hoboken, NJ',
    date:  'Apr 2023 - Aug 2023',
    iso:   ['2023-04', '2023-08'],
 },
];
---

<InfoLayout pageTitle={pageTitle}>
  <div class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-dvh flex flex-col justify-between gap-16 sm:gap-20">

    <!-- Page title -->
    <div class="space-y-4 sm:space-y-12">
      <h1
        class="text-white font-bold text-balance
               text-4xl md:text-6xl xl:text-8xl tracking-tight"
      >
        Experience & Education
      </h1>

      <!-- Experience timeline -->
      <section class="space-y-2 text-lg relative" aria-label="Work experience">
        <h2
          class="px-4 text-zinc-400 underline underline-offset-4 decoration-zinc-500"
        >
          Experience
        </h2>

        <!-- Animated vertical connector line -->
        <div
          aria-hidden="true"
          class="pointer-events-none absolute left-5 sm:left-7 top-16 bottom-0
                 w-px bg-zinc-800/60 overflow-hidden"
        >
          <div
            class="absolute inset-0 w-px h-1/3 bg-linear-to-b
                   from-transparent via-zinc-500/60 to-transparent
                   animate-lineScroll"
          />
        </div>

        <ul class="px-4 divide-y divide-zinc-800/60">
          {experience.map(({ title, org, date, iso }) => (
            <li
              class="group relative pl-8 sm:pl-12 py-6
                     transition-all duration-300 ease-in-out
                     hover:bg-zinc-800/15 hover:ring-1 hover:ring-zinc-800/60
                     hover:-translate-y-0.5 rounded-xl"
            >
              <!-- Timeline dot -->
              <span
                class="absolute left-0 sm:left-2 top-8
                       grid h-3 w-3 place-content-center"
                aria-hidden="true"
              >
                <span
                  class="h-2.5 w-2.5 rounded-full bg-zinc-600 ring-2 ring-zinc-900
                         transition-all duration-300
                         group-hover:bg-zinc-300 group-hover:ring-zinc-300/20"
                />
              </span>

              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-4">
                <h3 class="text-white font-semibold text-xl md:text-2xl">
                  {title}
                </h3>
                <span class="text-sm text-zinc-500 sm:whitespace-nowrap shrink-0">
                  {iso[1]
                    ? <><time datetime={iso[0]}>{date.split('-')[0]?.trim()}</time>{' - '}<time datetime={iso[1]}>{date.split('-')[1]?.trim()}</time></>
                    : <><time datetime={iso[0]}>{date.split('-')[0]?.trim()}</time>{' - Present'}</>
                  }
                </span>
              </div>

              <p class="text-zinc-500 mt-0.5">{org}</p>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <!-- Education -->
    <section class="space-y-2 text-lg" aria-label="Education">
      <h2
        class="px-4 text-zinc-400 underline underline-offset-4 decoration-zinc-500"
      >
        Education
      </h2>

      <div class="px-4 space-y-6">
        <div
          class="group rounded-xl transition-all duration-300
                 hover:bg-zinc-800/15 hover:ring-1 hover:ring-zinc-800/60
                 hover:-translate-y-0.5 p-4 sm:p-6"
        >
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-4">
            <h3 class="text-white font-semibold text-xl md:text-2xl">
              Stevens Institute of Technology —<br class="sm:hidden" />
              B.S. in Computer Science & Mathematics
            </h3>
            <span class="text-sm text-zinc-500 sm:whitespace-nowrap shrink-0">
              <time datetime="2022-09">Sept 2022</time> -
              <time datetime="2026-05">May 2026</time>
            </span>
          </div>

          <p class="text-zinc-500 mt-1">GPA: 3.96/4.0 | Graduated with Highest Honors</p>

          <div class="mt-3 grid gap-3">
            <p class="text-zinc-400">
              <span class="text-zinc-300">Coursework:</span>{' '}
              Computer Architecture, Operating Systems, Systems Programming, 
              Concurrent Programming, Parallel and GPU Programming, Data Structures and Algorithms, 
              Advanced Programming in the UNIX Environment, TCP/IP Networking, Deep Learning
            </p>
            <p class="text-zinc-400">
              <span class="text-zinc-300">Honors:</span>{' '}
              Summa Cum Laude, Reno A. Del Ben 1958 Endowed Scholarship; Dean's List (2022-2026);
              Edwin A. Stevens Scholarship, Rhodes Scholar Nominee, Marshall Scholar Nominee
            </p>
            <p class="text-zinc-400">
              <span class="text-zinc-300">Activities:</span>{' '}
              Stevens Computer Science Club, Stevens Linux User Group,
              Stevens Association of Mathematical Sciences, Stevens Student Managed Investment Fund
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section class="space-y-2 text-lg" aria-label="Skills">
      <h2
        class="px-4 text-zinc-400 underline underline-offset-4 decoration-zinc-500"
      >
        Skills
      </h2>

      <div class="px-4 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        {(
          [
            { heading: 'Languages',    items: languages    },
            { heading: 'Systems & Performance', items: systemsperf },
            { heading: 'Tools',           items: tools      },
            { heading: 'Libraries',           items: libraries      },
            { heading: 'Backend & Cloud',           items: backend      },
          ] as const
        ).map(({ heading, items }) => (
          <div
            class="group rounded-xl border border-zinc-800/60 p-4 sm:p-6
                   transition-all duration-300
                   hover:bg-zinc-800/10 hover:ring-1 hover:ring-zinc-800/60
                   hover:-translate-y-0.5"
          >
            <h3 class="text-zinc-200 font-medium">{heading}</h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {items.map((item) => (
                <li
                  class="inline-flex items-center rounded-full border
                         border-zinc-800/60 bg-zinc-900/40 px-3 py-1 text-sm
                         text-zinc-300 transition-all
                         hover:text-white hover:border-zinc-700
                         hover:bg-zinc-800/40"
                >
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

  </div>

  <style>
    @keyframes lineScroll {
      0%   { transform: translateY(-120%); }
      100% { transform: translateY(120%);  }
    }
    .animate-lineScroll {
      animation: lineScroll 6s linear infinite;
      will-change: transform;
    }
  </style>
</InfoLayout>