---
import InfoLayout from "../layouts/InfoLayout.astro";
const pageTitle = "Experience & Skills";
const languages = [
  "C++",
  "C",
  "C#",
  "Java",
  "Python",
  "SQL",
  "JavaScript",
  "R",
];
const technologies = [
  ".NET",
  "ASP.NET",
  "Microsoft SQL Server",
  "CLion",
  "Docker",
  "Microsoft Azure",
  "Apache Spark",
  "MongoDB",
  "HuggingFace",
  "OpenAI",
  "DeepSeek",
  "TensorFlow",
  "Jupyter Notebook",
];
const itStack = [
  "Microsoft Windows",
  "macOS",
  "Linux (Ubuntu, Debian, Arch)",
  "Azure DevOps Server",
  "Ubuntu Server",
  "VMware",
  "Parallels Desktop",
];
---

<InfoLayout pageTitle={pageTitle}>
  <div
    class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-dvh flex flex-col justify-between"
  >
    <div class="space-y-4 sm:space-y-12">
      <h1
        class="text-white font-bold text-balance text-4xl md:text-6xl xl:text-8xl tracking-tight"
      >
        Experience & Education
      </h1>

      <section class="space-y-2 text-lg relative">
        <h2
          class="px-4 text-zinc-400 underline underline-offset-4 decoration-zinc-500"
        >
          Experience
        </h2>

        <div
          aria-hidden="true"
          class="pointer-events-none absolute left-5 sm:left-7 top-16 bottom-0 w-px bg-zinc-800/60 overflow-hidden"
        >
          <div
            class="absolute inset-0 w-px h-1/3 bg-linear-to-b from-transparent via-zinc-500/60 to-transparent animate-lineScroll"
          >
          </div>
        </div>

        <ul class="px-4 divide-y divide-zinc-800/60">
          <li
            class="group relative pl-8 sm:pl-12 py-6 transition-all duration-300 ease-in-out hover:bg-zinc-800/15 hover:ring-1 hover:ring-zinc-800/60 hover:-translate-y-0.5 rounded-xl"
          >
            <span
              class="absolute left-0 sm:left-2 top-8 grid h-3 w-3 place-content-center"
            >
              <span
                class="h-2.5 w-2.5 rounded-full bg-zinc-600 ring-2 ring-zinc-900 transition-all duration-300 group-hover:bg-zinc-300 group-hover:ring-zinc-300/20"
              ></span>
            </span>

            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-white font-semibold text-xl md:text-2xl">
                Quantitative Developer Intern
              </h3>
              <span class="text-sm text-zinc-500 whitespace-nowrap"
                >May 2025 - Aug 2025</span
              >
            </div>
            <p class="text-zinc-500">Quantifi • New York City, NY</p>
          </li>

          <li
            class="group relative pl-8 sm:pl-12 py-6 transition-all duration-300 ease-in-out hover:bg-zinc-800/15 hover:ring-1 hover:ring-zinc-800/60 hover:-translate-y-0.5 rounded-xl"
          >
            <span
              class="absolute left-0 sm:left-2 top-8 grid h-3 w-3 place-content-center"
            >
              <span
                class="h-2.5 w-2.5 rounded-full bg-zinc-600 ring-2 ring-zinc-900 transition-all duration-300 group-hover:bg-zinc-300 group-hover:ring-zinc-300/20"
              ></span>
            </span>

            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-white font-semibold text-xl md:text-2xl">
                Quantitative Analyst
              </h3>
              <span class="text-sm text-zinc-500 whitespace-nowrap"
                >Jan 2025 - Present</span
              >
            </div>
            <p class="text-zinc-500">
              Stevens Student Managed Investment Fund • Hoboken, NJ
            </p>
          </li>

          <li
            class="group relative pl-8 sm:pl-12 py-6 transition-all duration-300 ease-in-out hover:bg-zinc-800/15 hover:ring-1 hover:ring-zinc-800/60 hover:-translate-y-0.5 rounded-xl"
          >
            <span
              class="absolute left-0 sm:left-2 top-8 grid h-3 w-3 place-content-center"
            >
              <span
                class="h-2.5 w-2.5 rounded-full bg-zinc-600 ring-2 ring-zinc-900 transition-all duration-300 group-hover:bg-zinc-300 group-hover:ring-zinc-300/20"
              ></span>
            </span>

            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-white font-semibold text-xl md:text-2xl">
                Software Engineer Intern
              </h3>
              <span class="text-sm text-zinc-500 whitespace-nowrap"
                >May 2024 - Aug 2024</span
              >
            </div>
            <p class="text-zinc-500">PanAgora Asset Management • Boston, MA</p>
          </li>

          <li
            class="group relative pl-8 sm:pl-12 py-6 transition-all duration-300 ease-in-out hover:bg-zinc-800/15 hover:ring-1 hover:ring-zinc-800/60 hover:-translate-y-0.5 rounded-xl"
          >
            <span
              class="absolute left-0 sm:left-2 top-8 grid h-3 w-3 place-content-center"
            >
              <span
                class="h-2.5 w-2.5 rounded-full bg-zinc-600 ring-2 ring-zinc-900 transition-all duration-300 group-hover:bg-zinc-300 group-hover:ring-zinc-300/20"
              ></span>
            </span>

            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-white font-semibold text-xl md:text-2xl">
                Summer Research Intern
              </h3>
              <span class="text-sm text-zinc-500 whitespace-nowrap"
                >Jun 2023 - Aug 2023</span
              >
            </div>
            <p class="text-zinc-500">
              Stevens Institute of Artificial Intelligence • Hoboken, NJ
            </p>
          </li>

          <li
            class="group relative pl-8 sm:pl-12 py-6 transition-all duration-300 ease-in-out hover:bg-zinc-800/15 hover:ring-1 hover:ring-zinc-800/60 hover:-translate-y-0.5 rounded-xl"
          >
            <span
              class="absolute left-0 sm:left-2 top-8 grid h-3 w-3 place-content-center"
            >
              <span
                class="h-2.5 w-2.5 rounded-full bg-zinc-600 ring-2 ring-zinc-900 transition-all duration-300 group-hover:bg-zinc-300 group-hover:ring-zinc-300/20"
              ></span>
            </span>

            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-white font-semibold text-xl md:text-2xl">
                Undergraduate Research Assistant
              </h3>
              <span class="text-sm text-zinc-500 whitespace-nowrap"
                >Apr 2023 - Aug 2023</span
              >
            </div>
            <p class="text-zinc-500">
              Stevens Institute of Technology • Hoboken, NJ
            </p>
          </li>

          <li
            class="group relative pl-8 sm:pl-12 py-6 transition-all duration-300 ease-in-out hover:bg-zinc-800/15 hover:ring-1 hover:ring-zinc-800/60 hover:-translate-y-0.5 rounded-xl"
          >
            <span
              class="absolute left-0 sm:left-2 top-8 grid h-3 w-3 place-content-center"
            >
              <span
                class="h-2.5 w-2.5 rounded-full bg-zinc-600 ring-2 ring-zinc-900 transition-all duration-300 group-hover:bg-zinc-300 group-hover:ring-zinc-300/20"
              ></span>
            </span>

            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-white font-semibold text-xl md:text-2xl">
                Teaching Assistant
              </h3>
              <span class="text-sm text-zinc-500 whitespace-nowrap"
                >Jan 2023 - Present</span
              >
            </div>
            <p class="text-zinc-500">
              Stevens Institute of Technology • Hoboken, NJ
            </p>
          </li>
        </ul>
      </section>
    </div>
    <section class="space-y-2 text-lg">
      <h2
        class="px-4 text-zinc-400 underline underline-offset-4 decoration-zinc-500"
      >
        Education
      </h2>

      <div class="px-4 space-y-6">
        <div
          class="group rounded-xl transition-all duration-300 hover:bg-zinc-800/15 hover:ring-1 hover:ring-zinc-800/60 hover:-translate-y-0.5 p-4 sm:p-6"
        >
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="text-white font-semibold text-xl md:text-2xl">
              Stevens Institute of Technology — B.S. in Computer Science &
              Mathematics
            </h3>
            <span class="text-sm text-zinc-500 whitespace-nowrap"
              >Sept 2022 - May 2026</span
            >
          </div>
          <p class="text-zinc-500">GPA: 3.95/4.0</p>

          <div class="mt-3 grid gap-3">
            <p class="text-zinc-400">
              <span class="text-zinc-300">Coursework:</span> Computer Architecture,
              Algorithms, Data Structures, Operating Systems, Deep Learning, Linear
              Algebra, Probability & Statistics, Modern Algebra, Theory of Computation,
              Multivariable Calculus
            </p>
            <p class="text-zinc-400">
              <span class="text-zinc-300">Awards:</span> Reno A. Del Ben 1958 Endowed
              Scholarship; Dean's List (2022-2025); Edwin A. Stevens Scholarship
            </p>
            <p class="text-zinc-400">
              <span class="text-zinc-300">Activities:</span> Stevens Computer Science
              Club, Stevens Linux User Group, Stevens Blueprint, Stevens Math Club
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="space-y-2 text-lg">
      <h2
        class="px-4 text-zinc-400 underline underline-offset-4 decoration-zinc-500"
      >
        Skills
      </h2>
      <div class="px-4 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        <div
          class="group rounded-xl border border-zinc-800/60 p-4 sm:p-6 transition-all duration-300 hover:bg-zinc-800/10 hover:ring-1 hover:ring-zinc-800/60 hover:-translate-y-0.5"
        >
          <h3 class="text-zinc-200 font-medium">Languages</h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {
              languages.map((item) => (
                <li class="inline-flex items-center rounded-full border border-zinc-800/60 bg-zinc-900/40 px-3 py-1 text-sm text-zinc-300 transition-all hover:text-white hover:border-zinc-700 hover:bg-zinc-800/40">
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
        <div
          class="group rounded-xl border border-zinc-800/60 p-4 sm:p-6 transition-all duration-300 hover:bg-zinc-800/10 hover:ring-1 hover:ring-zinc-800/60 hover:-translate-y-0.5"
        >
          <h3 class="text-zinc-200 font-medium">Technologies</h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {
              technologies.map((item) => (
                <li class="inline-flex items-center rounded-full border border-zinc-800/60 bg-zinc-900/40 px-3 py-1 text-sm text-zinc-300 transition-all hover:text-white hover:border-zinc-700 hover:bg-zinc-800/40">
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
        <div
          class="group rounded-xl border border-zinc-800/60 p-4 sm:p-6 transition-all duration-300 hover:bg-zinc-800/10 hover:ring-1 hover:ring-zinc-800/60 hover:-translate-y-0.5"
        >
          <h3 class="text-zinc-200 font-medium">IT</h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {
              itStack.map((item) => (
                <li class="inline-flex items-center rounded-full border border-zinc-800/60 bg-zinc-900/40 px-3 py-1 text-sm text-zinc-300 transition-all hover:text-white hover:border-zinc-700 hover:bg-zinc-800/40">
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>
  </div>

  <style>
    @keyframes lineScroll {
      0% {
        transform: translateY(-120%);
      }
      100% {
        transform: translateY(120%);
      }
    }
    .animate-lineScroll {
      animation: lineScroll 6s linear infinite;
      will-change: transform;
    }
  </style>
</InfoLayout>
