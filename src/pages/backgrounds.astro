---
import InfoLayout from '@layouts/InfoLayout.astro';
import ShaderBackground from '@components/backgrounds/ShaderBackground';
import ApplyVariant from '@components/backgrounds/ApplyVariant';
import {
  backgroundGroups,
  backgroundLabels,
  type BackgroundGroup,
} from '@components/backgrounds/presets';

const pageTitle = 'Backgrounds';
const groups = Object.keys(backgroundGroups) as BackgroundGroup[];
---

<InfoLayout pageTitle={pageTitle}>
  <div class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-dvh flex flex-col">
    <h1 class="text-white font-bold text-balance text-4xl md:text-6xl xl:text-8xl tracking-tight">
      Backgrounds
    </h1>

    <p class="mt-4 md:mt-8 text-xl xl:text-2xl text-zinc-400 text-balance">
      Pick one and it applies across the site. Quality and speed live in the settings
      button in the corner.
    </p>

    {groups.map((group) => (
      <section class="mt-10 sm:mt-14">
        <h2 class="text-sm uppercase tracking-wide text-zinc-400">{group}</h2>
        <ul class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-3">
          {backgroundGroups[group].map((variant) => (
            <li class="list-none">
              <div class="relative h-48 w-full overflow-hidden rounded-2xl border border-zinc-800">
                <ShaderBackground override={variant} quality="low" unmountWhenOffscreen client:visible />
              </div>
              <div class="mt-3 flex items-center justify-between gap-3">
                <div class="min-w-0">
                  <p class="font-mono text-sm text-zinc-200">{variant}</p>
                  <p class="truncate text-xs text-zinc-400">{backgroundLabels[variant]}</p>
                </div>
                <ApplyVariant variant={variant} client:visible />
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</InfoLayout>
