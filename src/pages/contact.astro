---
import InfoLayout from '../layouts/InfoLayout.astro';

const pageTitle = 'Contact';
---

<InfoLayout pageTitle={pageTitle}>
  <div class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-dvh flex flex-col justify-between">

    <div>
      <h1
        class="text-white font-bold text-balance
               text-4xl md:text-6xl xl:text-8xl tracking-tight"
      >
        Contact
      </h1>

      <p class="mt-4 md:mt-8 lg:mt-12 text-xl xl:text-2xl text-zinc-400 text-balance">
        Checkout my GitHub and LinkedIn page or just drop me an email!
      </p>

      <div class="mt-6 sm:mt-12 flex flex-col gap-1">

        <!-- Email -->
        <a
          href="mailto:jhizgiaev2704@gmail.com"
          class="mb-8 w-fit group flex items-center gap-1
                 text-base lg:text-xl text-zinc-400 hover:text-zinc-50"
          aria-label="Send email to jhizgiaev2704@gmail.com"
        >
          jhizgiaev2704@gmail.com
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="-rotate-45 group-hover:rotate-0 transition-all duration-300 ease-in-out"
            width="24" height="24" viewBox="0 0 24 24"
            aria-hidden="true" focusable="false"
          >
            <path fill="currentColor" d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2S2 6.477 2 12s4.477 10 10 10" opacity=".5" />
            <path fill="currentColor" d="M13.53 8.47a.75.75 0 1 0-1.06 1.06l1.72 1.72H8a.75.75 0 0 0 0 1.5h6.19l-1.72 1.72a.75.75 0 1 0 1.06 1.06l3-3a.75.75 0 0 0 0-1.06z" />
          </svg>
        </a>

        <!-- LinkedIn -->
        <a
          href="https://www.linkedin.com/in/joshuahizgiaev/"
          target="_blank"
          rel="noopener noreferrer"
          class="w-fit group flex items-center gap-1 text-base
                 hover:text-zinc-100 cursor-pointer text-zinc-500"
          aria-label="Visit LinkedIn profile (opens in new tab)"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="transition-all ease-in-out" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.137 1.447-2.137 2.939v5.667H9.35V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.369-1.85 3.6 0 4.266 2.368 4.266 5.448v6.293zM5.337 7.433c-1.144 0-2.067-.926-2.067-2.067 0-1.144.923-2.067 2.067-2.067 1.144 0 2.067.923 2.067 2.067 0 1.141-.923 2.067-2.067 2.067zM7.119 20.452H3.554V9h3.565v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.225.792 24 1.771 24h20.451C23.2 24 24 23.225 24 22.271V1.729C24 .774 23.2 0 22.225 0z" />
          </svg>
          LinkedIn
          <svg xmlns="http://www.w3.org/2000/svg" class="-rotate-45 group-hover:rotate-0 transition-all duration-300 ease-in-out" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 12h2.5M20 12l-6-6m6 6l-6 6m6-6H9.5" />
          </svg>
        </a>

        <!-- GitHub -->
        <a
          href="https://github.com/Josh-Hiz"
          target="_blank"
          rel="noopener noreferrer"
          class="w-fit group flex items-center gap-1 text-base
                 hover:text-zinc-100 cursor-pointer text-zinc-500"
          aria-label="Visit GitHub profile (opens in new tab)"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="transition-all ease-in-out" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.387.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.757-1.333-1.757-1.09-.744.084-.729.084-.729 1.205.084 1.84 1.236 1.84 1.236 1.07 1.835 2.807 1.305 3.492.998.108-.776.417-1.305.76-1.605-2.665-.304-5.466-1.333-5.466-5.93 0-1.31.468-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.48 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12z" />
          </svg>
          GitHub
          <svg xmlns="http://www.w3.org/2000/svg" class="-rotate-45 group-hover:rotate-0 transition-all duration-300 ease-in-out" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 12h2.5M20 12l-6-6m6 6l-6 6m6-6H9.5" />
          </svg>
        </a>

      </div>
    </div>

    <!-- Semantic address element for location info -->
    <address class="not-italic">
      <p class="text-base text-zinc-500">Hoboken, NJ</p>
      <p class="text-base text-zinc-500">New York City, NY</p>
      <p class="text-base text-zinc-500">United States</p>
    </address>

  </div>
</InfoLayout>