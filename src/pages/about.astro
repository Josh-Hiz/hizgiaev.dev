---
import InfoLayout from '../layouts/InfoLayout.astro';
---
<InfoLayout
  pageTitle="About"
  pageDescription="Joshua Hizgiaev — new-graduate computer scientist from Stevens Institute of Technology, now a C++ Software Engineer at Trexquant. Interests: high-performance computing, GPU programming, parallelism, and low-latency trading systems."
>
  <div
    class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-dvh flex flex-col justify-between gap-16 sm:gap-32">
    <div class="space-y-4 sm:space-y-12">
      <h1
        class="text-white font-bold text-balance
               text-4xl md:text-6xl xl:text-8xl tracking-tight"
      >
        About Me
      </h1>

      {/* Photo floats right; paragraphs wrap beside it and continue full-width below.
          Clearfix (after:*) keeps the float contained within this block. */}
      <div class="after:block after:clear-both after:content-['']">
        <figure
          class="mb-8 w-full max-w-80 mx-auto
        lg:float-right lg:mx-0 lg:mb-6 lg:ml-10 xl:ml-12 lg:w-80 xl:w-88 lg:max-w-none"
        >
           <div class="relative aspect-square overflow-hidden rounded-2xl
                   border border-zinc-700/70 bg-zinc-900 shadow-2xl shadow-black/40"
          >
            {/* Placeholder shown until /profile.jpg exists (or if it fails to load) */}
            <div
              class="absolute inset-0 flex items-center justify-center
                     bg-[radial-gradient(120%_120%_at_30%_20%,#1c1a17_0%,#0a0a0a_70%)]"
              aria-hidden="true"
            >
              <span class="font-bold text-6xl tracking-tight text-zinc-700 select-none">JH</span>
            </div>

            <img
              src="/aperture-iris-ascii.gif"
              alt="Joshua Hizgiaev"
              width="660"
              height="660"
              loading="lazy"
              decoding="async"
              class="relative z-10 h-full w-full object-cover"
              onerror="this.style.display='none'"
            />

            <span
              class="pointer-events-none absolute inset-0 z-20 rounded-2xl
                     ring-1 ring-inset ring-white/5"
              aria-hidden="true"
            ></span>
          </div>

          <figcaption class="mt-3 px-1 text-sm text-zinc-400">
            Rotating ASCII art of the Aperture Science Logo from Portal
          </figcaption>
        </figure>

        <p class="mb-6 xl:mb-8 text-xl xl:text-2xl text-zinc-400 text-pretty">
          Welcome! I am a new-graduate computer science student at
          Stevens Institute of Technology.
        </p>

        <p class="mb-6 xl:mb-8 text-xl xl:text-2xl text-zinc-400 text-pretty">
          I am a self-taught programmer and my current interests include
          high-performance computing, computer architectures, GPU programming,
          parallelism, C++, high-frequency trading, algorithms, and performance engineering.
        </p>

        <p class="text-xl xl:text-2xl text-zinc-400 text-pretty">
          My most recent professional experiences include being a Software
          Engineer intern at PanAgora Asset Management and as Software
          Engineer Intern at Quantifi. After graduating from Stevens, I am
          excited to say I will be a C++ Software Engineer at Trexquant! Working on
          high-performance AI infrastructure and low-latency trading systems.
        </p>
      </div>
    </div>

    <div class="space-y-2 text-lg">
      <h2
        class="px-4 text-zinc-400 underline underline-offset-4 decoration-zinc-500"
      >
        Achievements / Recent News
      </h2>

      <ul class="px-4 text-zinc-400 list-disc list-outside space-y-1">
        <li><time datetime="2026-06-11">06/11/2026</time>: Joined Trexquant as a C++ Software Engineer</li>
        <li><time datetime="2025-08-20">08/20/2025</time>: My new website goes live</li>
        <li>
          <time datetime="2025-05-29">05/29/2025</time>: Joined Quantifi as a
          Software Engineer Intern
        </li>
        <li>
          <time datetime="2025-01-29">01/29/2025</time>: Accepted into Stevens
          Student Managed Investment Fund as a Quantitative Analyst
        </li>
        <li>
          <time datetime="2024-05-27">05/27/2024</time>: Joined PanAgora Asset
          Management as a Software Engineer Intern
        </li>
      </ul>
    </div>
  </div>
</InfoLayout>