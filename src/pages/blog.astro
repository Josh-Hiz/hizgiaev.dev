---
import InfoLayout from '../layouts/InfoLayout.astro';
import BlogPost from '../components/BlogPost.astro';

const pageTitle = 'My Blog';

interface PostFrontmatter {
  title: string;
  description?: string;
  pubDate: string;
  author?: string;
  tags?: string[];
}

interface Post {
  url: string;
  frontmatter: PostFrontmatter;
}

const allPosts = Object.values(import.meta.glob<Post>('./posts/*.md', { eager: true }));

const sortedPosts = allPosts
  .filter((p) => Boolean(p.frontmatter?.title))
  .sort(
    (a, b) =>
      new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime(),
  );
---

<InfoLayout pageTitle={pageTitle}>
  <div class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-dvh flex flex-col">
    <h1 class="text-white font-bold text-balance text-4xl md:text-6xl xl:text-8xl tracking-tight">
      My Blog
    </h1>

    <p class="mt-4 md:mt-8 lg:mt-12 text-xl xl:text-2xl text-zinc-400 text-balance">
      Checkout my newest blog!
    </p>

    <div class="mt-6 sm:mt-12">
      {sortedPosts.length === 0 ? (
        <p class="text-zinc-500 text-lg">No posts yet &mdash; check back soon.</p>
      ) : (
        <ul>
          {sortedPosts.map((post) => (
            <BlogPost url={post.url} title={post.frontmatter.title} pubDate={post.frontmatter.pubDate} />
          ))}
        </ul>
      )}
    </div>
  </div>
</InfoLayout>
