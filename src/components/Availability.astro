---
// No layout changes — this component was already correct and responsive.
// Added aria-live="polite" so screen readers announce the availability status
// when it changes (e.g. if it's conditionally rendered by a parent).
---
<div
  class="flex items-center gap-2 py-4"
  aria-live="polite"
  role="status"
>
  <!-- Pulsing availability indicator -->
  <span class="relative flex items-center justify-center size-3" aria-hidden="true">
    <span
      class="absolute inline-flex h-full w-full animate-ping duration-1000
             rounded-full bg-zinc-100 opacity-75"
    ></span>
    <span class="relative inline-flex size-2 rounded-full bg-zinc-100"></span>
  </span>

  <p class="text-zinc-300">
    Looking for junior full-time, winter, and summer internship opportunities!
  </p>
</div>