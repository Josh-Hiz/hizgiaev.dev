---
import BaseLayout from './BaseLayout.astro';
import WarpBackground from '../components/backgrounds/Warp';
import Footer from '../components/Footer.astro';

interface Props {
  pageTitle?: string | undefined;
}
const { pageTitle } = Astro.props;
---

<BaseLayout pageTitle={pageTitle}>
  <div class="mx-auto flex w-full max-w-7xl gap-4">
    <!--
      Decorative sidebar. A static warm gradient is the base layer (visible on
      mobile and before hydration); the animated warp only mounts at md+ and
      paints on top. `sticky` keeps it in the flow so it stays aligned with the
      centered column and pins while scrolling.
    -->
    <div
      class="relative hidden w-4 shrink-0 sm:block md:w-64 xl:w-96"
      aria-hidden="true"
    >
      <div
        class="sticky top-0 h-dvh overflow-hidden rounded-b-full
               bg-[linear-gradient(160deg,#14120f_0%,#d07a01_58%,#f0edea_100%)]"
      >
        <WarpBackground
          colors={['#14120f', '#d07a01', '#f0edea']}
          speed={0.15}
          swirl={1.5}
          swirlIterations={6}
          client:media="(min-width: 768px)"
        />
      </div>
    </div>

    <main class="relative z-0 min-w-0 flex-1">
      <slot />
      <Footer />
    </main>
  </div>
</BaseLayout>
