---
import 'katex/dist/katex.min.css';
import InfoLayout from '../layouts/InfoLayout.astro';
import { slugifyTag } from '@lib/tags';
// KaTeX styles are bundled and emitted only on pages that use this layout,
// so blog posts get math rendering without a render-blocking CDN request and
// the rest of the site ships none of it.

interface Props {
  title: string;
  description?: string | undefined;
  pubDate: Date | string;
  author?: string | undefined;
  tags?: string[] | undefined;
}

const { title, description, pubDate, author, tags = [] } = Astro.props;

const d = pubDate instanceof Date ? pubDate : new Date(pubDate);
const isValidDate = !Number.isNaN(d.getTime());
const isoDate = isValidDate ? d.toISOString() : '';
const formattedDate = isValidDate
  ? d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : String(pubDate ?? '');
---

<InfoLayout pageTitle={title}>
  <article class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-dvh flex flex-col">
    <header>
      <h1 class="text-white font-bold text-balance text-4xl md:text-6xl xl:text-8xl tracking-tight">
        {title}
      </h1>

      {description && (
        <p class="mt-4 md:mt-6 lg:mt-8 text-xl xl:text-2xl text-zinc-400 text-balance">
          {description}
        </p>
      )}

      <div class="mt-4 md:mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm md:text-base text-zinc-400">
        {formattedDate && <time datetime={isoDate}>{formattedDate}</time>}
        {author && (
          <>
            <span aria-hidden="true">&bull;</span>
            <span>{author}</span>
          </>
        )}
        {tags.length > 0 && (
          <>
            <span aria-hidden="true">&bull;</span>
            <ul class="flex flex-wrap gap-2">
              {tags.map((t) => (
                <li class="px-2 py-0.5 rounded-full text-zinc-400 border border-zinc-800">
                  <a href={`/tags/${slugifyTag(t)}`} class="hover:text-zinc-200">#{t}</a>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>

      <div class="mt-6 border-b border-zinc-800"></div>
    </header>

    <section
      class="prose prose-invert prose-zinc max-w-none mt-6 sm:mt-10
             prose-p:my-4 prose-p:leading-relaxed
             prose-h2:mt-8 prose-h2:mb-3 prose-h2:text-2xl md:prose-h2:text-3xl
             prose-ul:my-4 prose-ol:my-4 prose-li:my-1
             prose-a:text-zinc-300 hover:prose-a:text-zinc-200
             prose-code:font-mono prose-pre:bg-zinc-800/60"
    >
      <slot />
    </section>
  </article>
</InfoLayout>
