{
  "headers": [
    {
      "source": "/(.*)\\.(xml|json|webmanifest|txt|rss)",
      "headers": [
        { "key": "Cache-Control",        "value": "public, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control",    "value": "max-age=14400, stale-while-revalidate=60" },
        { "key": "Vercel-CDN-Cache-Control", "value": "max-age=14400, stale-while-revalidate=60" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control",        "value": "public, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control",    "value": "max-age=14400, stale-while-revalidate=60" },
        { "key": "Vercel-CDN-Cache-Control", "value": "max-age=14400, stale-while-revalidate=60" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}