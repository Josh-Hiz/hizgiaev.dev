{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx":             "react-jsx",
    "jsxImportSource": "react",

    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "paths": {
      "@components/*": ["./src/components/*"],
      "@layouts/*":    ["./src/layouts/*"],
      "@styles/*":     ["./src/styles/*"],
      "@lib/*":        ["./src/lib/*"]
    },

    "strict":                    true,
    "noUncheckedIndexedAccess":  true,
    "exactOptionalPropertyTypes": true
  }
}